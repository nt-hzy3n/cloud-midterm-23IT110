{{#if success}}
  <div class="alert alert-success">
    ✓ {{success}}
  </div>
{{/if}}

{{#if error}}
  <div class="alert alert-error">
    ⚠ {{error}}
  </div>
{{/if}}

<section class="card form-card">
  <h2>Thêm sách mới</h2>
  <p class="subtitle">Tiền tố mã sản phẩm bắt buộc: <strong>110</strong> (3 số cuối MSSV 23IT110)</p>
  
  <form action="/books/add" method="POST" class="book-form">
    <div class="form-grid">
      <div class="form-group">
        <label for="productCode">Mã sản phẩm (Bắt đầu bằng 110)</label>
        <input type="text" id="productCode" name="productCode" placeholder="Ví dụ: 110001" required>
      </div>

      <div class="form-group">
        <label for="title">Tên sách</label>
        <input type="text" id="title" name="title" placeholder="Tên cuốn sách" required>
      </div>

      <div class="form-group">
        <label for="author">Tác giả</label>
        <input type="text" id="author" name="author" placeholder="Tên tác giả" required>
      </div>

      <div class="form-group">
        <label for="price">Giá sách (VNĐ)</label>
        <input type="number" id="price" name="price" placeholder="Giá gốc" min="1" required>
      </div>
    </div>

    <div class="form-actions">
      <button type="submit" class="btn btn-primary">Thêm sách</button>
    </div>
  </form>
</section>

<section class="card table-card">
  <h2>Danh sách sách</h2>
  <div class="table-responsive">
    <table class="data-table">
      <thead>
        <tr>
          <th>Mã sách</th>
          <th>Tên sách</th>
          <th>Tác giả</th>
          <th>Giá gốc</th>
          <th>VAT</th>
          <th>Giá sau thuế</th>
        </tr>
      </thead>
      <tbody>
        {{#if books.length}}
          {{#each books}}
            <tr>
              <td><code>{{this.productCode}}</code></td>
              <td>{{this.title}}</td>
              <td>{{this.author}}</td>
              <td>{{this.price}} VNĐ</td>
              <td>{{this.vatRate}}%</td>
              <td><strong>{{this.priceAfterTax}} VNĐ</strong></td>
            </tr>
          {{/each}}
        {{else}}
          <tr>
            <td colspan="6" class="empty-state">
              Chưa có dữ liệu sách trong cơ sở dữ liệu.
            </td>
          </tr>
        {{/if}}
      </tbody>
    </table>
  </div>
</section>
